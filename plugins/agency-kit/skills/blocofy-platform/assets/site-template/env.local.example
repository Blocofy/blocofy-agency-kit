# Keys for ONE Blocofy site. In the site folder this file is named .env.local.
# It is listed in .gitignore. Never commit it, and never paste these values
# into an agent config file.
#
# Fill in the three empty values. Quote a value that contains spaces or symbols.

# The address of the site, starting with https://
BLOCOFY_URL=

# The API key (Blocofy panel: Ayarlar > Bağlantılar ve anahtarlar > Yeni API anahtarı)
BLOCOFY_API_TOKEN=

# The CLI token (same screen: Yeni CLI token'ı)
BLOCOFY_CLI_TOKEN=

# Do not edit the three lines below. The Blocofy CLI reads these names; the
# first two take their values from the lines above when a shell loads the file:
#   set -a; . ./.env.local; set +a
BLOCOFY_TOKEN="$BLOCOFY_CLI_TOKEN"
BLOCOFY_API_KEY="$BLOCOFY_API_TOKEN"
BLOCOFY_API_URL=https://app.blocofy.com
